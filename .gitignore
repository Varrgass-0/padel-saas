# ============================================================================
# QLUBOS — .gitignore (Seguridad: NUNCA subir claves ni variables de entorno)
# ============================================================================

# --- Variables de entorno y secretos ---------------------------------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local
# Cualquier otro .env.* excepto la plantilla pública sin valores reales
.env.*
!.env.example

# Llaves/certificados privados
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks

# Credenciales de servicios (por si se descargan archivos JSON de claves)
service-account*.json
*credentials*.json
supabase/.temp/
supabase/.branches/

# --- Dependencias y builds ---------------------------------------------------
node_modules/
dist/
build/
.vite/
.cache/
coverage/

# --- Vercel / despliegue -----------------------------------------------------
.vercel/

# --- Logs --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Sistema operativo y editores --------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
